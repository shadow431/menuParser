# Copy to .env.mealie and adjust values before running docker compose

MEALIE_PORT=9925
MEALIE_BASE_URL=http://localhost:9925
MEALIE_ALLOW_SIGNUP=true

# Container user/group on the Docker host
PUID=1000
PGID=1000
TZ=America/Chicago

# Change these before using outside a throwaway local test
POSTGRES_USER=mealie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mealie

# Optional NFS settings for compose.mealie.nfs.yml
# Warning: live PostgreSQL data on NFS can be less reliable than local storage.
# Safest default is local volumes, plus backups exported to NFS.
NFS_SERVER=192.168.1.10
NFS_VERSION=4
NFS_MEALIE_DATA_PATH=/export/mealie/data
NFS_MEALIE_PGDATA_PATH=/export/mealie/postgres
